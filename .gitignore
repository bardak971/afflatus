# session notes with a LAN address, disk paths and personal details: never published
HANDOVER*.md

node_modules/
dist/
dist-demo/
data/
data-demo*/
*.log
.env
.env.*
!.env.example

# what the release scripts stage and pack (scripts/release)
/release/

# Python bytecode from the node pack (ComfyUI writes it beside the sources)
__pycache__/
*.pyc

# vitest's local cache (it holds this machine's paths)
**/.vitest/

# a local corpus of other people's workflows for the importer's regression check (packages/workflows/test/corpus.test.ts): not published
packages/workflows/test/corpus/*
!packages/workflows/test/corpus/expect.json
!packages/workflows/test/corpus/README.md

# working notes, kept locally only
STATUS.md

# Claude Code agent worktrees
.claude/worktrees/

# throwaway probe scripts (scripts/zz-*): they hold this machine's paths
scripts/zz-*

# an MCP client's project config holds its token (docs/mcp.md)
.mcp.json
