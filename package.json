{
  "name": "afflatus",
  "private": true,
  "version": "0.2.1",
  "description": "A self-hosted studio for pictures, videos and timelines, in front of your own ComfyUI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite apps/web",
    "build": "vite build apps/web",
    "start": "tsx apps/server/src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "check:graphs": "tsx scripts/check-graphs.ts",
    "check:player": "tsx scripts/check-player.ts",
    "restore": "tsx scripts/restore-backup.ts",
    "comfy:scan": "tsx scripts/comfy-scan.ts",
    "comfy:load": "tsx scripts/comfy-load.ts",
    "catalog:save": "tsx scripts/save-node-catalog.ts",
    "corpus:expect": "tsx scripts/corpus-expect.mts"
  },
  "devDependencies": {
    "@afflatus/comfy": "workspace:*",
    "@afflatus/core": "workspace:*",
    "@afflatus/recipes": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "oxlint": "1.85.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
